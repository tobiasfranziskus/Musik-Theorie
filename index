<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>🎼 Musiktheorie – Interaktiv</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: 'Segoe UI', system-ui, sans-serif;
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
    min-height: 100vh; padding: 16px; color: #e8e8e8;
  }
  .app { max-width: 900px; margin: 0 auto; }
  .card {
    background: rgba(255,255,255,0.05);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 20px;
    padding: 24px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
    margin-bottom: 16px;
  }
  h1 {
    font-size: 2rem; text-align: center; margin-bottom: 8px;
    background: linear-gradient(135deg, #e94560, #f5a623, #4ecdc4);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  }
  .subtitle { text-align: center; color: #a0a0b0; margin-bottom: 24px; font-size: .95rem; }

  /* ===== Menu ===== */
  .section-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 12px;
  }
  .section-btn {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 14px;
    padding: 16px;
    color: #e8e8e8; cursor: pointer;
    transition: all .25s; font-family: inherit;
    text-align: left; font-size: .9rem;
    display: flex; flex-direction: column; gap: 6px;
  }
  .section-btn:hover {
    background: rgba(233,69,96,0.15);
    border-color: rgba(233,69,96,0.5);
    transform: translateY(-2px);
  }
  .section-btn .icon { font-size: 1.5rem; }
  .section-btn .title { font-weight: 600; }
  .section-btn .desc { font-size: .75rem; color: #808090; }

  /* ===== Exercise header ===== */
  .ex-header {
    display: flex; justify-content: space-between;
    align-items: center; flex-wrap: wrap; gap: 10px;
    margin-bottom: 16px;
  }
  .ex-header .left { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .btn-back {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 10px;
    padding: 6px 14px;
    color: #e8e8e8;
    cursor: pointer;
    font-family: inherit;
    font-size: .85rem;
    transition: all .2s;
  }
  .btn-back:hover { background: rgba(255,255,255,0.18); }
  .badge {
    background: rgba(255,255,255,0.08);
    border-radius: 20px; padding: 5px 14px;
    font-size: .8rem; color: #a0a0b0;
  }
  .badge.score { background: linear-gradient(135deg, #4ecdc4, #2d9c95); color: #fff; font-weight: 600; }
  .badge.streak { background: linear-gradient(135deg, #f5a623, #e8860c); color: #fff; font-weight: 600; display: none; }
  .badge.streak.on { display: inline-block; }

  .progress-outer {
    height: 5px; background: rgba(255,255,255,0.08);
    border-radius: 3px; margin-bottom: 20px; overflow: hidden;
  }
  .progress-inner {
    height: 100%; width: 0%;
    background: linear-gradient(90deg, #e94560, #f5a623);
    transition: width .4s;
  }
  .q-label {
    display: inline-block;
    background: rgba(78,205,196,0.15);
    color: #4ecdc4;
    border-radius: 8px;
    padding: 4px 12px;
    font-size: .78rem; font-weight: 600;
    margin-bottom: 12px;
  }
  .q-text { font-size: 1.08rem; line-height: 1.5; margin-bottom: 18px; color: #fff; }
  .hint { font-size: .82rem; color: #9090a0; margin-bottom: 10px; font-style: italic; }

  /* ===== Staff ===== */
  .staff-box {
    background: #fff; border-radius: 12px;
    padding: 10px; margin-bottom: 14px;
    display: flex; justify-content: center;
    overflow-x: auto;
  }
  .staff-box svg { max-width: 100%; height: auto; }
  .staff-interactive { cursor: crosshair; }
  .staff-interactive svg { cursor: crosshair; }

  /* ===== Accidental selector ===== */
  .acc-row {
    display: flex; gap: 8px; flex-wrap: wrap;
    margin: 10px 0 14px; align-items: center;
  }
  .acc-row .label {
    color: #a0a0b0; font-size: .85rem; margin-right: 4px;
  }
  .acc-btn {
    width: 46px; height: 46px;
    border-radius: 10px;
    border: 2px solid rgba(255,255,255,0.15);
    background: rgba(255,255,255,0.06);
    color: #e8e8e8;
    font-size: 1.35rem;
    cursor: pointer;
    transition: all .2s;
    font-family: Georgia, serif;
    line-height: 1;
  }
  .acc-btn:hover:not(:disabled) { background: rgba(255,255,255,0.15); }
  .acc-btn.active {
    background: rgba(233,69,96,0.35);
    border-color: #e94560;
    color: #fff;
    box-shadow: 0 0 12px rgba(233,69,96,0.4);
  }
  .acc-btn:disabled { opacity: 0.4; cursor: default; }

  /* ===== Action row ===== */
  .action-row {
    display: flex; gap: 10px; flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .action-row .btn { flex: 1; min-width: 100px; }
  .btn {
    border: none; border-radius: 12px;
    padding: 13px 20px; cursor: pointer;
    font-family: inherit; font-size: .92rem;
    font-weight: 600; transition: all .2s;
  }
  .btn-check {
    background: linear-gradient(135deg, #4ecdc4, #2d9c95);
    color: #fff;
  }
  .btn-check:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgba(78,205,196,0.3);
  }
  .btn-check:disabled { opacity: 0.4; cursor: not-allowed; }
  .btn-undo {
    background: rgba(255,255,255,0.08);
    color: #e8e8e8;
    border: 1px solid rgba(255,255,255,0.15);
  }
  .btn-undo:hover:not(:disabled) { background: rgba(255,255,255,0.18); }
  .btn-clear {
    background: rgba(231,76,60,0.15);
    color: #e74c3c;
    border: 1px solid rgba(231,76,60,0.3);
  }
  .btn-clear:hover:not(:disabled) { background: rgba(231,76,60,0.28); }
  .btn-undo:disabled, .btn-clear:disabled { opacity: 0.35; cursor: not-allowed; }
  .btn-primary {
    background: linear-gradient(135deg, #4ecdc4, #2d9c95);
    color: #fff; width: 100%;
    display: none;
  }
  .btn-primary.show { display: block; }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(78,205,196,0.3); }

  /* ===== Options (MC) ===== */
  .options {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 10px; margin-bottom: 16px;
  }
  .option {
    background: rgba(255,255,255,0.06);
    border: 2px solid rgba(255,255,255,0.12);
    border-radius: 12px; padding: 14px;
    color: #e8e8e8; cursor: pointer;
    transition: all .2s; font-family: inherit;
    font-size: .95rem; text-align: left;
    display: flex; align-items: center; gap: 10px;
  }
  .option:disabled { cursor: default; }
  .option:hover:not(:disabled) {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.25);
  }
  .option .letter {
    display: flex; align-items: center; justify-content: center;
    width: 28px; height: 28px; border-radius: 8px;
    background: rgba(255,255,255,0.08);
    font-weight: 700; font-size: .8rem; flex-shrink: 0;
  }
  .option.correct { background: rgba(46,204,113,0.2); border-color: #2ecc71; }
  .option.correct .letter { background: #2ecc71; color: #fff; }
  .option.wrong { background: rgba(231,76,60,0.2); border-color: #e74c3c; }
  .option.wrong .letter { background: #e74c3c; color: #fff; }

  .feedback {
    border-radius: 12px; padding: 14px 18px;
    margin-bottom: 14px; display: none;
    animation: slideUp .3s ease;
  }
  .feedback.show { display: block; }
  .feedback.ok { background: rgba(46,204,113,0.12); border: 1px solid rgba(46,204,113,0.3); }
  .feedback.err { background: rgba(231,76,60,0.12); border: 1px solid rgba(231,76,60,0.3); }
  .feedback-title {
    font-weight: 700; margin-bottom: 6px;
    display: flex; align-items: center; gap: 8px;
  }
  .feedback.ok .feedback-title { color: #2ecc71; }
  .feedback.err .feedback-title { color: #e74c3c; }
  .feedback-text { font-size: .9rem; color: #c0c0d0; line-height: 1.5; }
  .feedback-text b { color: #fff; }

  /* ===== Results ===== */
  .results { display: none; text-align: center; }
  .results.show { display: block; }
  .results h2 {
    font-size: 1.8rem; margin-bottom: 8px;
    background: linear-gradient(135deg, #4ecdc4, #f5a623);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  }
  .results .big { font-size: 3rem; font-weight: 800; margin: 12px 0; color: #fff; }
  .results .bar {
    height: 10px; background: rgba(255,255,255,0.08);
    border-radius: 5px; margin: 18px 0 24px; overflow: hidden;
  }
  .results .bar-inner {
    height: 100%; width: 0%;
    background: linear-gradient(90deg, #e94560, #f5a623, #4ecdc4);
    border-radius: 5px; transition: width 1s;
  }
  .results .actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes pop {
    0% { transform: scale(0.7); opacity: 0; }
    60% { transform: scale(1.08); }
    100% { transform: scale(1); opacity: 1; }
  }
  .pop { animation: pop .25s ease; }

  @media (max-width: 520px) {
    .options { grid-template-columns: 1fr; }
    h1 { font-size: 1.5rem; }
    .acc-btn { width: 40px; height: 40px; font-size: 1.15rem; }
  }
</style>
</head>
<body>

<div class="app">
  <!-- ============ MENU ============ -->
  <div id="menu" class="card">
    <h1>🎼 Musiktheorie – Interaktiv</h1>
    <p class="subtitle">Klicke Noten direkt ins System! Mit Vorzeichen ♯ ♭ ♮ und Live-Prüfung.</p>
    <div class="section-grid" id="sectionGrid"></div>
  </div>

  <!-- ============ EXERCISE ============ -->
  <div id="exercise" class="card" style="display:none;">
    <div class="ex-header">
      <div class="left">
        <button class="btn-back" onclick="showMenu()">← Menü</button>
        <span class="badge" id="qCounter">Frage 1/8</span>
      </div>
      <div style="display:flex;gap:8px;">
        <span class="badge streak" id="streakBadge">🔥 0</span>
        <span class="badge score" id="scoreBadge">0 Punkte</span>
      </div>
    </div>
    <div class="progress-outer"><div class="progress-inner" id="progressBar"></div></div>
    <span class="q-label" id="sectionLabel">…</span>
    <div class="q-text" id="qText">…</div>

    <!-- Interactive staff mode -->
    <div id="staffMode" style="display:none;">
      <div class="hint">💡 Klicke ins Notensystem, um eine Note zu setzen.</div>
      <div class="staff-box staff-interactive" id="staffInteractive"></div>
      <div class="acc-row">
        <span class="label">Vorzeichen:</span>
        <button class="acc-btn" data-acc="#" title="Kreuz">♯</button>
        <button class="acc-btn" data-acc="b" title="Bes">♭</button>
        <button class="acc-btn" data-acc="n" title="Auflösungszeichen">♮</button>
        <button class="acc-btn active" data-acc="" title="Kein Vorzeichen">—</button>
      </div>
      <div class="action-row">
        <button class="btn btn-check" id="btnCheck" onclick="checkStaff()">✓ Prüfen</button>
        <button class="btn btn-undo" id="btnUndo" onclick="undoStaff()">↩ Rückgängig</button>
        <button class="btn btn-clear" id="btnClear" onclick="clearStaff()">🗑 Alles löschen</button>
      </div>
    </div>

    <!-- MC mode -->
    <div id="mcMode" style="display:none;">
      <div class="staff-box" id="staffDisplay" style="display:none;"></div>
      <div class="options" id="options"></div>
    </div>

    <div class="feedback" id="feedback"></div>
    <button class="btn btn-primary" id="nextBtn" onclick="nextQuestion()">Weiter →</button>
  </div>

  <!-- ============ RESULTS ============ -->
  <div id="results" class="card results">
    <h2 id="resultsTitle">🎉 Geschafft!</h2>
    <div class="big" id="resultsScore">0/8</div>
    <div style="color:#a0a0b0;font-size:.9rem;">richtige Antworten</div>
    <div class="bar"><div class="bar-inner" id="resultsBar"></div></div>
    <p id="resultsMsg" style="color:#e8e8e8;margin-bottom:20px;"></p>
    <div class="actions">
      <button class="btn btn-primary show" style="width:auto;padding:14px 32px;" onclick="showMenu()">🔄 Zurück zum Menü</button>
    </div>
  </div>
</div>

<script>
/* ============================================================
   GLOBAL UTILITIES
   ============================================================ */
const NOTE_STEPS = { c:0, d:1, e:2, f:3, g:4, a:5, h:6 };
const STEP_NAMES = ['c','d','e','f','g','a','h'];
const SHARP = { c:'cis', d:'dis', e:'eis', f:'fis', g:'gis', a:'ais', h:'his' };
const FLAT  = { c:'ces', d:'des', e:'es',  f:'fes', g:'ges', a:'as',  h:'b'   };
const SUPER = { 0:'₀', 1:'₁', 2:'', 3:'¹', 4:'²', 5:'³', 6:'⁴' };
const CHROM = { c:0, d:2, e:4, f:5, g:7, a:9, h:11 };

function absStep(name, octave) { return (octave - 4) * 7 + NOTE_STEPS[name]; }
function stepToPitch(step) {
  return { name: STEP_NAMES[((step % 7) + 7) % 7], octave: Math.floor(step / 7) + 4 };
}
function pitchValue(name, octave, acc) {
  let v = octave * 12 + CHROM[name];
  if (acc === '#') v++;
  else if (acc === 'b') v--;
  else if (acc === '##') v += 2;
  else if (acc === 'bb') v -= 2;
  return v;
}
function fullNoteName(name, octave, acc) {
  let base = name;
  if (acc === '#') base = SHARP[name];
  else if (acc === 'b') base = FLAT[name];
  else if (acc === '##') base = SHARP[name] + 'is';
  else if (acc === 'bb') base = FLAT[name] + 'es';
  if (octave <= 2) return base.toUpperCase() + (SUPER[octave] || '');
  return base + (SUPER[octave] || '');
}
const R = arr => arr[Math.floor(Math.random() * arr.length)];
const RI = (a, b) => Math.floor(Math.random() * (b - a + 1)) + a;
function shuffle(a) {
  a = [...a];
  for (let i = a.length - 1; i > 0; i--) {
    const j = RI(0, i); [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

/* ============================================================
   STATIC SCORE RENDERER (for MC questions)
   ============================================================ */
function renderStaticScore(staff) {
  const ls = 10, topY = 50, botY = topY + 4*ls;
  const paddingX = 14, clefW = 48, noteW = 50;
  const W = paddingX + clefW + staff.notes.length * noteW + paddingX;
  const clefOff = staff.clef === 'treble' ? 2 : -10;
  const yForStep = s => botY - (s - clefOff) * (ls/2);

  let svg = `<svg viewBox="0 0 ${W} 160" xmlns="http://www.w3.org/2000/svg" style="width:${W}px;">`;
  for (let i = 0; i < 5; i++) {
    const y = topY + i*ls;
    svg += `<line x1="${paddingX}" y1="${y}" x2="${W-paddingX}" y2="${y}" stroke="#222" stroke-width="1.1"/>`;
  }
  if (staff.clef === 'treble')
    svg += `<text x="${paddingX+4}" y="${botY+6}" font-size="58" fill="#222" font-family="Georgia,serif">𝄞</text>`;
  else
    svg += `<text x="${paddingX+8}" y="${topY+6}" font-size="46" fill="#222" font-family="Georgia,serif">𝄢</text>`;

  staff.notes.forEach((note, i) => {
    const x = paddingX + clefW + (i + 0.5) * noteW;
    const step = absStep(note.name, note.octave);
    const s = step - clefOff;
    const y = yForStep(step);

    // Ledger lines
    if (s < 0) {
      const lowest = s % 2 === 0 ? s : s + 1;
      for (let k = -2; k >= lowest; k -= 2) {
        const ly = yForStep(k + clefOff);
        svg += `<line x1="${x-13}" y1="${ly}" x2="${x+13}" y2="${ly}" stroke="#222" stroke-width="1"/>`;
      }
    }
    if (s > 8) {
      const highest = s % 2 === 0 ? s : s - 1;
      for (let k = 10; k <= highest; k += 2) {
        const ly = yForStep(k + clefOff);
        svg += `<line x1="${x-13}" y1="${ly}" x2="${x+13}" y2="${ly}" stroke="#222" stroke-width="1"/>`;
      }
    }
    // Accidental
    if (note.accidental) {
      const sym = { '#':'♯', 'b':'♭', 'n':'♮', '##':'𝄪', 'bb':'𝄫' }[note.accidental] || '♯';
      svg += `<text x="${x-19}" y="${y+5}" font-size="18" fill="#222" font-family="Georgia,serif" text-anchor="middle">${sym}</text>`;
    }
    // Notehead
    svg += `<ellipse cx="${x}" cy="${y}" rx="7" ry="5" transform="rotate(-20 ${x} ${y})" fill="#222"/>`;
    // Stem
    const stemUp = s < 4;
    if (stemUp)
      svg += `<line x1="${x+6.5}" y1="${y}" x2="${x+6.5}" y2="${y-30}" stroke="#222" stroke-width="1.5"/>`;
    else
      svg += `<line x1="${x-6.5}" y1="${y}" x2="${x-6.5}" y2="${y+30}" stroke="#222" stroke-width="1.5"/>`;
  });
  svg += `</svg>`;
  return svg;
}

/* ============================================================
   INTERACTIVE STAFF
   ============================================================ */
let staffCtx = null; // { container, config, state }

function initInteractiveStaff(container, config) {
  const state = {
    userNotes: [],       // { name, octave, accidental }
    selectedAcc: null,   // null | '#' | 'b' | 'n'
    checked: false,
    results: [],
  };
  staffCtx = { container, config, state };
  renderInteractive();
  updateInteractiveControls();
}

function renderInteractive() {
  const { container, config, state } = staffCtx;
  const ls = 10, topY = 50, botY = topY + 4*ls;
  const paddingX = 14, clefW = 48, gap = 8;
  const slotW = config.slotW || 52;
  const clefOff = config.clef === 'treble' ? 2 : -10;
  const cursorX = paddingX + clefW + gap;
  const W = cursorX + config.totalSlots * slotW + paddingX;
  const slotX = i => cursorX + (i + 0.5) * slotW;
  const yForStep = s => botY - (s - clefOff) * (ls/2);

  const fixedCount = (config.fixedNotes || []).length;
  const currentSlot = fixedCount + state.userNotes.length;

  let svg = `<svg viewBox="0 0 ${W} 160" xmlns="http://www.w3.org/2000/svg" style="width:${W}px; touch-action: manipulation;">`;

  // Staff lines
  for (let i = 0; i < 5; i++) {
    const y = topY + i*ls;
    svg += `<line x1="${paddingX}" y1="${y}" x2="${W-paddingX}" y2="${y}" stroke="#222" stroke-width="1.1"/>`;
  }
  // Clef
  if (config.clef === 'treble')
    svg += `<text x="${paddingX+4}" y="${botY+6}" font-size="58" fill="#222" font-family="Georgia,serif">𝄞</text>`;
  else
    svg += `<text x="${paddingX+8}" y="${topY+6}" font-size="46" fill="#222" font-family="Georgia,serif">𝄢</text>`;

  // Slot highlight (current position)
  if (!state.checked && currentSlot < config.totalSlots) {
    const x = slotX(currentSlot) - slotW/2 + 4;
    svg += `<rect x="${x}" y="${topY-6}" width="${slotW-8}" height="${botY-topY+12}" fill="rgba(78,205,196,0.10)" rx="6"/>`;
  }

  // Fixed notes (grey)
  (config.fixedNotes || []).forEach((n, i) => {
    drawNoteInto(svg, slotX(i), n, clefOff, yForStep, '#555');
  });

  // User notes
  state.userNotes.forEach((n, i) => {
    const color = state.checked
      ? (state.results[i] ? '#2ecc71' : '#e74c3c')
      : '#e94560';
    drawNoteInto(svg, slotX(fixedCount + i), n, clefOff, yForStep, color);
  });

  // Overlay of correct solution on wrong slots
  if (state.checked) {
    config.expected.forEach((exp, i) => {
      if (state.results[i] === false) {
        const x = slotX(fixedCount + i) + 20;
        drawNoteInto(svg, x, exp, clefOff, yForStep, 'rgba(46,204,113,0.55)', true);
      }
    });
  }

  svg += `</svg>`;
  container.innerHTML = svg;
}

function drawNoteInto(svg, x, note, clefOff, yForStep, color, small) {
  const step = absStep(note.name, note.octave);
  const s = step - clefOff;
  const y = yForStep(step);

  // Ledger lines
  if (s < 0) {
    const lowest = s % 2 === 0 ? s : s + 1;
    for (let k = -2; k >= lowest; k -= 2) {
      const ly = yForStep(k + clefOff);
      svg += `<line x1="${x-13}" y1="${ly}" x2="${x+13}" y2="${ly}" stroke="#222" stroke-width="1"/>`;
    }
  }
  if (s > 8) {
    const highest = s % 2 === 0 ? s : s - 1;
    for (let k = 10; k <= highest; k += 2) {
      const ly = yForStep(k + clefOff);
      svg += `<line x1="${x-13}" y1="${ly}" x2="${x+13}" y2="${ly}" stroke="#222" stroke-width="1"/>`;
    }
  }
  // Accidental
  if (note.accidental) {
    const sym = { '#':'♯', 'b':'♭', 'n':'♮' }[note.accidental] || '♯';
    svg += `<text x="${x-19}" y="${y+5}" font-size="18" fill="${color}" font-family="Georgia,serif" text-anchor="middle">${sym}</text>`;
  }
  // Notehead
  const rx = small ? 5 : 7, ry = small ? 3.5 : 5;
  svg += `<ellipse cx="${x}" cy="${y}" rx="${rx}" ry="${ry}" transform="rotate(-20 ${x} ${y})" fill="${color}"/>`;
  // Stem
  if (!small) {
    const stemUp = s < 4;
    if (stemUp)
      svg += `<line x1="${x+6.5}" y1="${y}" x2="${x+6.5}" y2="${y-30}" stroke="${color}" stroke-width="1.5"/>`;
    else
      svg += `<line x1="${x-6.5}" y1="${y}" x2="${x-6.5}" y2="${y+30}" stroke="${color}" stroke-width="1.5"/>`;
  }
}

function handleStaffClick(evt) {
  const { config, state, container } = staffCtx;
  if (state.checked) return;
  const fixedCount = (config.fixedNotes || []).length;
  if (state.userNotes.length >= config.totalSlots - fixedCount) return;
  
  const svg = container.querySelector('svg');
  if (!svg) return;
  
  const pt = svg.createSVGPoint();
  pt.x = evt.clientX;
  pt.y = evt.clientY;
  const loc = pt.matrixTransform(svg.getScreenCTM().inverse());
  
  const ls = 10, topY = 50, botY = topY + 4*ls;
  const clefOff = config.clef === 'treble' ? 2 : -10;
  
  // Convert click y to step
  let rel = (botY - loc.y) / (ls/2);
  rel = Math.round(rel);
  rel = Math.max(-9, Math.min(15, rel)); // reasonable range
  const step = rel + clefOff;
  const pitch = stepToPitch(step);
  
  // Apply accidental: 'n' → null, else pass through
  const acc = state.selectedAcc === 'n' ? null : state.selectedAcc;
  
  state.userNotes.push({ name: pitch.name, octave: pitch.octave, accidental: acc });
  renderInteractive();
  updateInteractiveControls();
}

function setAccidental(acc) {
  if (!staffCtx || staffCtx.state.checked) return;
  staffCtx.state.selectedAcc = acc;
  document.querySelectorAll('.acc-btn').forEach(b => {
    b.classList.toggle('active', b.dataset.acc === (acc || ''));
  });
}

function undoStaff() {
  if (!staffCtx || staffCtx.state.checked) return;
  staffCtx.state.userNotes.pop();
  renderInteractive();
  updateInteractiveControls();
}

function clearStaff() {
  if (!staffCtx || staffCtx.state.checked) return;
  staffCtx.state.userNotes = [];
  renderInteractive();
  updateInteractiveControls();
}

function updateInteractiveControls() {
  if (!staffCtx) return;
  const { config, state } = staffCtx;
  const fixedCount = (config.fixedNotes || []).length;
  const ready = state.userNotes.length === config.totalSlots - fixedCount;
  document.getElementById('btnCheck').disabled = !ready || state.checked;
  document.getElementById('btnUndo').disabled = state.checked || state.userNotes.length === 0;
  document.getElementById('btnClear').disabled = state.checked || state.userNotes.length === 0;
  document.querySelectorAll('.acc-btn').forEach(b => b.disabled = state.checked);
}

function checkStaff() {
  if (!staffCtx) return;
  const { config, state } = staffCtx;
  state.checked = true;
  state.results = state.userNotes.map((u, i) => {
    const exp = config.expected[i];
    if (!exp) return false;
    return pitchValue(u.name, u.octave, u.accidental) === pitchValue(exp.name, exp.octave, exp.accidental);
  });
  const allCorrect = state.results.every(r => r);
  
  // Update UI
  renderInteractive();
  updateInteractiveControls();
  
  // Score
  if (allCorrect) { state_score++; state_streak++; if (state_streak > state_bestStreak) state_bestStreak = state_streak; }
  else state_streak = 0;
  document.getElementById('scoreBadge').textContent = `${state_score} Punkte`;
  const sEl = document.getElementById('streakBadge');
  if (state_streak >= 2) { sEl.textContent = `🔥 ${state_streak}`; sEl.classList.add('on'); }
  else sEl.classList.remove('on');
  
  // Feedback
  const fb = document.getElementById('feedback');
  const solution = config.expected.map(n => fullNoteName(n.name, n.octave, n.accidental)).join(' – ');
  if (allCorrect) {
    fb.className = 'feedback show ok';
    fb.innerHTML = `<div class="feedback-title">✅ Perfekt!</div>
      <div class="feedback-text">${config.explanation}</div>`;
  } else {
    const nCorrect = state.results.filter(r => r).length;
    fb.className = 'feedback show err';
    fb.innerHTML = `<div class="feedback-title">❌ Noch nicht ganz (${nCorrect}/${state.results.length} richtig)</div>
      <div class="feedback-text">Korrekte Lösung: <b>${solution}</b><br>${config.explanation}</div>`;
  }
  document.getElementById('nextBtn').classList.add('show');
}

