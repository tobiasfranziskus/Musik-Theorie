    };
  } else {
    const correct = d.acc === 0 ? 'keine Vorzeichen' : `${Math.abs(d.acc)} ${d.acc > 0 ? 'Kreuz(e)' : 'B(s)'}`;
    const all = ['keine Vorzeichen','1 Kreuz','2 Kreuze','3 Kreuze','4 Kreuze','5 Kreuze','6 Kreuze','1 B','2 Bs','3 Bs','4 Bs','5 Bs'];
    const wrongs = shuffle(all.filter(a => a !== correct)).slice(0, 3);
    const opts = shuffle([correct, ...wrongs]);
    return {
      mode: 'mc',
      q: `Wie viele Vorzeichen hat ${d.key}-Dur?`,
      options: opts,
      correct: opts.indexOf(correct),
      explanation: `${d.key}-Dur hat ${correct}.`
    };
  }
}

