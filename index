const QUESTIONS_PER_ROUND = 8;
let state_section = null;
let state_questions = [];
let state_current = 0;
let state_score = 0;
let state_streak = 0;
let state_bestStreak = 0;
let state_answered = false;

function buildMenu() {
  const grid = document.getElementById('sectionGrid');
  grid.innerHTML = '';
  SECTIONS.forEach(s => {
    const btn = document.createElement('button');
    btn.className = 'section-btn';
    btn.innerHTML = `<span class="icon">${s.icon}</span><span class="title">${s.title}</span><span class="desc">${s.desc}</span>`;
    btn.onclick = () => startSection(s);
    grid.appendChild(btn);
  });
}

function startSection(section) {
  state_section = section;
  state_questions = [];
  for (let i = 0; i < QUESTIONS_PER_ROUND; i++) {
    const gen = R(section.gens);
    let q;
    try { q = gen(); } catch(e) { console.error(e); i--; continue; }
    if (q) state_questions.push(q);
  }
  state_current = 0;
  state_score = 0;
  state_streak = 0;
  state_bestStreak = 0;
  state_answered = false;
  document.getElementById('menu').style.display = 'none';
  document.getElementById('results').classList.remove('show');
  document.getElementById('exercise').style.display = 'block';
  showQuestion();
}

function showQuestion() {
  const q = state_questions[state_current];
  state_answered = false;
  document.getElementById('qCounter').textContent = `Frage ${state_current+1}/${state_questions.length}`;
  document.getElementById('scoreBadge').textContent = `${state_score} Punkte`;
  const sEl = document.getElementById('streakBadge');
  if (state_streak >= 2) { sEl.textContent = `🔥 ${state_streak}`; sEl.classList.add('on'); }
  else sEl.classList.remove('on');
  document.getElementById('progressBar').style.width = `${(state_current / state_questions.length) * 100}%`;
  document.getElementById('sectionLabel').textContent = state_section.title;
  document.getElementById('qText').textContent = q.q;

  // Feedback reset
  document.getElementById('feedback').className = 'feedback';
  document.getElementById('feedback').innerHTML = '';
  document.getElementById('nextBtn').classList.remove('show');
  document.getElementById('nextBtn').textContent = state_current === state_questions.length-1 ? 'Ergebnis anzeigen 🏁' : 'Weiter →';

  if (q.mode === 'staff') {
    document.getElementById('staffMode').style.display = 'block';
    document.getElementById('mcMode').style.display = 'none';
    // Reset accidental buttons
    document.querySelectorAll('.acc-btn').forEach(b => {
      b.classList.toggle('active', b.dataset.acc === '');
    });
    const container = document.getElementById('staffInteractive');
    // Remove old listener first (in case)
    container.replaceWith(container.cloneNode(false));
    const newContainer = document.getElementById('staffInteractive');
    newContainer.addEventListener('click', handleStaffClick);
    initInteractiveStaff(newContainer, q);
  } else {
    document.getElementById('staffMode').style.display = 'none';
    document.getElementById('mcMode').style.display = 'block';
    const staffBox = document.getElementById('staffDisplay');
    if (q.staff) { staffBox.innerHTML = renderStaticScore(q.staff); staffBox.style.display = 'flex'; }
    else staffBox.style.display = 'none';
    const optionsEl = document.getElementById('options');
    optionsEl.innerHTML = '';
    const letters = ['A','B','C','D'];
    q.options.forEach((opt, i) => {
      const btn = document.createElement('button');
      btn.className = 'option';
      btn.innerHTML = `<span class="letter">${letters[i]}</span><span>${opt}</span>`;
      btn.onclick = () => checkMC(i);
      optionsEl.appendChild(btn);
    });
  }
}

function checkMC(idx) {
  if (state_answered) return;
  state_answered = true;
  const q = state_questions[state_current];
  const btns = document.querySelectorAll('.option');
  btns.forEach((b, i) => {
    b.disabled = true;
    if (i === q.correct) b.classList.add('correct');
    if (i === idx && i !== q.correct) b.classList.add('wrong');
  });
  const ok = idx === q.correct;
  if (ok) { state_score++; state_streak++; if (state_streak > state_bestStreak) state_bestStreak = state_streak; }
  else state_streak = 0;
  document.getElementById('scoreBadge').textContent = `${state_score} Punkte`;
  const sEl = document.getElementById('streakBadge');
  if (state_streak >= 2) { sEl.textContent = `🔥 ${state_streak}`; sEl.classList.add('on'); }
  else sEl.classList.remove('on');
  const fb = document.getElementById('feedback');
  const letter = ['A','B','C','D'][q.correct];
  if (ok) {
    fb.className = 'feedback show ok';
    fb.innerHTML = `<div class="feedback-title">✅ Richtig!</div><div class="feedback-text">${q.explanation}</div>`;
  } else {
    fb.className = 'feedback show err';
    fb.innerHTML = `<div class="feedback-title">❌ Leider falsch</div><div class="feedback-text">Richtig ist <b>${letter}) ${q.options[q.correct]}</b>.<br>${q.explanation}</div>`;
  }
  document.getElementById('nextBtn').classList.add('show');
}

function nextQuestion() {
  state_current++;
  if (state_current >= state_questions.length) showResults();
  else showQuestion();
}

function showResults() {
  document.getElementById('exercise').style.display = 'none';
  const r = document.getElementById('results');
  r.classList.add('show');
  const total = state_questions.length;
  const pct = (state_score / total) * 100;
  document.getElementById('resultsScore').textContent = `${state_score}/${total}`;
  document.getElementById('resultsBar').style.width = `${pct}%`;
  let title, msg;
  if (pct >= 90) { title = '🏆 Ausgezeichnet!'; msg = 'Du bist ein Musiktheorie-Profi!'; }
  else if (pct >= 70) { title = '🎉 Sehr gut!'; msg = 'Nur noch kleine Lücken – weiter so!'; }
  else if (pct >= 50) { title = '👍 Gut gemacht!'; msg = 'Wiederhole einige Themen gezielt.'; }
  else { title = '📚 Übungsbedarf'; msg = 'Arbeite die Skripte nochmal durch und versuche es erneut!'; }
  if (state_bestStreak >= 3) msg += ` Längste Serie: 🔥 ${state_bestStreak}`;
  document.getElementById('resultsTitle').textContent = title;
  document.getElementById('resultsMsg').textContent = msg;
}

function showMenu() {
  document.getElementById('results').classList.remove('show');
  document.getElementById('exercise').style.display = 'none';
  document.getElementById('menu').style.display = 'block';
  buildMenu();
}

// Accidental buttons
document.querySelectorAll('.acc-btn').forEach(btn => {
  btn.addEventListener('click', () => setAccidental(btn.dataset.acc));
});

// INIT
buildMenu();
</script>
</body>
