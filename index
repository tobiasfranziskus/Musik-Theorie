// ---------- INTERACTIVE: Dur-Tonleiter ----------
const SCALE_DATA = {
  'C-Dur':  ['c4','d4','e4','f4','g4','a4','h4','c5'],
  'G-Dur':  ['g4','a4','h4','c5','d5','e5','fis5','g5'],
  'D-Dur':  ['d4','e4','fis4','g4','a4','h4','cis5','d5'],
  'A-Dur':  ['a4','h4','cis5','d5','e5','fis5','gis5','a5'],
  'F-Dur':  ['f4','g4','a4','b4','c5','d5','e5','f5'],
  'B-Dur':  ['b3','c4','d4','es4','f4','g4','a4','b4'],
  'Es-Dur': ['es4','f4','g4','as4','b4','c5','d5','es5'],
};
function parseNoteStr(str) {
  const m = str.match(/^([a-h])(is|es)?(\d)$/);
  if (!m) return null;
  const [, letter, suffix, oct] = m;
  let acc = null;
  if (suffix === 'is') acc = '#';
  else if (suffix === 'es') acc = 'b';
  // German: 'es' as a note name (not suffix) - but our format ensures suffix
  return { name: letter, octave: parseInt(oct), accidental: acc };
}
function genTonleiterInteractive() {
  const keyName = R(Object.keys(SCALE_DATA));
  const notes = SCALE_DATA[keyName].map(parseNoteStr);
  return {
    mode: 'staff',
    q: `Schreibe die ${keyName}-Tonleiter aufwärts (8 Töne, mit Vorzeichen)!`,
    clef: 'treble',
    fixedNotes: [],
    totalSlots: 8,
    slotW: 46,
    expected: notes,
    explanation: `Die ${keyName}-Tonleiter lautet: ${notes.map(n => fullNoteName(n.name, n.octave, n.accidental)).join(' – ')}`
  };
}

// ---------- MC: Notenwerte ----------
function genNotenwertMC() {
  const timeSigs = [[4,4],[3,4],[2,4]];
  const [top, bot] = R(timeSigs);
  const measureBeats = top * (4/bot);
  const noteVals = { whole:4, half:2, quarter:1, eighth:0.5 };
  let beats = 0;
  const used = [];
  const namesPool = ['c','d','e','f','g','a','h'];
  while (beats < measureBeats - 1) {
    const v = R(Object.keys(noteVals));
    const val = noteVals[v];
    if (beats + val > measureBeats - 0.25) break;
    used.push({ value: v, name: R(namesPool), octave: 4 });
    beats += val;
  }
  if (used.length === 0) used.push({ value: 'quarter', name: 'c', octave: 4 });
  const missing = measureBeats - beats;
  const missingName = Object.entries(noteVals).find(([n,v]) => Math.abs(v - missing) < 0.01)?.[0];
  if (!missingName) return genNotenwertMC();
  const nameMap = { whole:'ganze Note', half:'halbe Note', quarter:'Viertelnote', eighth:'Achtelnote' };
  const wrongs = shuffle(Object.keys(noteVals).filter(o => o !== missingName)).slice(0, 3);
  const opts = shuffle([missingName, ...wrongs]);
  return {
    mode: 'mc',
    q: `Welcher Notenwert vervollständigt den ${top}/${bot}-Takt?`,
    staff: { clef: 'treble', notes: used.slice(0, 3) },
    options: opts.map(o => nameMap[o]),
    correct: opts.indexOf(missingName),
    explanation: `Es fehlen ${missing} Schlag(e) → ${nameMap[missingName]}.`
  };
}

