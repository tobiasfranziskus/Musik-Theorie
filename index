    { key:'As', acc:-4, parallel:'f' }, { key:'Des', acc:-5, parallel:'b' },
  ];
  const d = R(data);
  if (Math.random() < 0.5) {
    const correct = d.parallel + '-Moll';
    const wrongs = shuffle(data.filter(x => x.parallel !== d.parallel).map(x => x.parallel + '-Moll')).slice(0, 3);
    const opts = shuffle([correct, ...wrongs]);
    return {
