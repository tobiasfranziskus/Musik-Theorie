// ---------- MC: Notennamen ----------
function genNotennameMC() {
  const clef = Math.random() < 0.6 ? 'treble' : 'bass';
  const names = ['c','d','e','f','g','a','h'];
  const octaves = clef === 'treble' ? [4,5] : [2,3];
  const name = R(names);
  const octave = R(octaves);
  const r = Math.random();
  const accidental = r < 0.15 ? '#' : r < 0.3 ? 'b' : null;
  const correct = fullNoteName(name, octave, accidental);
  const pool = new Set([correct]);
  for (let i = 0; i < 30 && pool.size < 4; i++) {
    const n2 = R(names), a2 = R(['#','b',null]);
    const opt = fullNoteName(n2, octave, a2);
    if (opt !== correct) pool.add(opt);
  }
  const opts = shuffle(Array.from(pool).slice(0, 4));
  return {
    mode: 'mc',
    q: `Wie heißt dieser Ton im ${clef === 'treble' ? 'Violin' : 'Bass'}schlüssel?`,
    staff: { clef, notes: [{ name, octave, accidental }] },
    options: opts,
    correct: opts.indexOf(correct),
    explanation: `${correct}${accidental ? (accidental === '#' ? ` – enharmonisch: ${fullNoteName(name, octave, 'b')}` : ` – enharmonisch: ${fullNoteName(name, octave, '#')}`) : ''}`
  };
}

// ---------- MC: Enharmonik ----------
function genEnharmMC() {
  const pairs = [['cis','des'],['dis','es'],['fis','ges'],['gis','as'],['ais','b'],['eis','f'],['his','c']];
  const p = R(pairs);
  const flip = Math.random() < 0.5;
  const from = flip ? p[1] : p[0];
  const to = flip ? p[0] : p[1];
  const wrongPool = pairs.flat().filter(n => n !== to && n !== from);
  const wrongs = [];
  while (wrongs.length < 3) { const w = R(wrongPool); if (!wrongs.includes(w)) wrongs.push(w); }
  const opts = shuffle([to, ...wrongs]);
  return {
    mode: 'mc',
    q: `Welcher Ton ist die enharmonische Verwechslung von „${from}"?`,
    options: opts,
    correct: opts.indexOf(to),
    explanation: `${from} = ${to} (klingen identisch)`
  };
}

